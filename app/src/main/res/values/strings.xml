    <!-- Welcome -->
    <string name="welcome_title">Shelf Counter</string>
    <string name="welcome_subtitle">Demo · barcode-based product counting</string>
    <string name="welcome_body">Point the camera at a row of products. The app reads the 1D barcodes and counts how many identical items are lined up.</string>
    <string name="step_1">1. Tap Start counting and aim at the shelf</string>
    <string name="step_2">2. Keep the whole row in the frame for a moment</string>
    <string name="step_3">3. Tap Close camera to see the list</string>
    <string name="start_counting">Start counting</string>
    <string name="supported_codes">EAN-13 · EAN-8 · UPC-A/E · Code 128/39/93 · ITF · Codabar · works offline</string>

    <!-- Permission -->
    <string name="permission_title">Camera access needed</string>
    <string name="permission_message">Shelf Counter needs the camera to read barcodes. You can allow it in the app settings.</string>
    <string name="open_settings">Open settings</string>
    <string name="permission_denied">Camera permission is required to count products.</string>

