    <!-- Welcome -->
    <string name="welcome_title">Shelf Counter</string>
    <string name="welcome_subtitle">Demo · barcode + shape-based product counting</string>
    <string name="welcome_body">Read the barcode of a product (on the item or on the shelf label), then photograph its row: the app recognises the first item and counts the identical ones lined up behind it.</string>
    <string name="step_1">1. Scan the barcode of the first item in the row</string>
    <string name="step_2">2. Frame the row at an angle and tap Count items</string>
    <string name="step_3">3. Save each count, then tap Close camera to see the list</string>
    <string name="start_counting">Start counting</string>
    <string name="supported_codes">EAN-13 · EAN-8 · UPC-A/E · Code 128/39/93 · ITF · Codabar · works offline</string>

