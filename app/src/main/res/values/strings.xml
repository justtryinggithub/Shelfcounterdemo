    <!-- Welcome -->
    <string name="welcome_title">Shelf Counter</string>
    <string name="welcome_subtitle">Demo · barcode + shape-based product counting</string>
    <string name="welcome_body">Walk along the aisle with the camera open: every barcode read starts a count of the identical products lined up behind it, automatically.</string>
    <string name="step_1">1. Tap Start counting and walk along the shelf</string>
    <string name="step_2">2. Pause a second on each row: barcode and products in view, at an angle</string>
    <string name="step_3">3. Tap Close camera to see the list</string>
    <string name="start_counting">Start counting</string>
    <string name="supported_codes">EAN-13 · EAN-8 · UPC-A/E · Code 128/39/93 · ITF · Codabar · works offline</string>

    <!-- Permission -->
    <string name="permission_title">Camera access needed</string>
